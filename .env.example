# Database Connection (uses psycopg2-binary)
DATABASE_URL=postgresql+psycopg2://postgres:admin@localhost:5432/dialisis

# Auth0 Configuration
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_API_AUDIENCE=https://api.dialisis.com/patients

# Internal Microservices (Local / Docker network)
USERS_SERVICE_URL=http://localhost:8001
ROLES_SERVICE_URL=http://localhost:8002
# USERS_SERVICE_URL=http://dialisis-users:8000
# ROLES_SERVICE_URL=http://dialisis-roles:8000

# Docker examples
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@dialisis-users-db:5432/dialisis
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/dialisis

# CORS Configuration (comma-separated origins or JSON array)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


