# Database Connection (uses psycopg2-binary)
DATABASE_URL=postgresql+psycopg2://postgres:admin@localhost:5432/dialisis

# Auth0 Configuration
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_API_AUDIENCE=https://api.dialisis.com/patients

